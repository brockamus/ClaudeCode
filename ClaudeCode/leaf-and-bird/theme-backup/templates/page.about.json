    "faq": {
      "type": "store-faq",
      "blocks": {
        "f1": {
          "type": "faq_item",
          "settings": {
            "question": "What does 'clean beauty' mean to Leaf & Bird?",
            "answer": "<p>For us, clean beauty means full ingredient transparency — no synthetic fragrances, no artificial preservatives, no harsh chemicals, no 'fragrance' catch-alls. Every ingredient is listed and every purpose is explained. We formulate with nature-first ingredients and clinical-grade actives, made in the USA.<\/p>"
          }
        },
        "f2": {
          "type": "faq_item",
          "settings": {
            "question": "Why do you use tallow in skincare?",
            "answer": "<p>Grass-fed beef tallow has been used as a moisturizer for centuries. Its fatty acid profile is nearly identical to human sebum, making it one of the most biocompatible skincare ingredients available. It absorbs deeply, delivers fat-soluble vitamins A, D, E, and K, and is naturally free of synthetic additives.<\/p>"
          }
        },
        "f3": {
          "type": "faq_item",
          "settings": {
            "question": "Are your products cruelty-free?",
            "answer": "<p>Absolutely. Leaf & Bird products are 100% cruelty-free. We never test on animals. We believe in using animal-derived ingredients responsibly and ethically, but testing on animals is something we will never do.<\/p>"
          }
        },
        "f4": {
          "type": "faq_item",
          "settings": {
            "question": "Where are your products made?",
            "answer": "<p>All Leaf & Bird products are formulated and manufactured in the United States. Our grass-fed tallow is sourced from US pasture-raised cattle, our essential oils are certified organic, and our clinical actives come from trusted US laboratories.<\/p>"
          }
        },
        "f5": {
          "type": "faq_item",
          "settings": {
            "question": "How can I contact you?",
            "answer": "<p>We'd love to hear from you. Visit our <a href='\/pages\/contact'>Contact page<\/a> to send us a message, or email us directly. We respond to all inquiries within 24 hours.<\/p>"
          }
        }
      },
      "block_order": [
        "f1",
        "f2",
        "f3",
        "f4",
        "f5"
      ],
