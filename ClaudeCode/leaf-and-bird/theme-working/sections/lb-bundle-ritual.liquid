{%- comment %} L&B — bundle ritual section. Reads lb_bundle.ritual JSON metafield: {am: [{product, label, action}], pm: [...], notes: "..."}. {%- endcomment %}
{%- assign ritual = product.metafields.lb_bundle.ritual.value -%}
{%- if ritual and ritual != blank -%}
<section class="lb-bundle-ritual">
  <div class="lb-bundle-ritual__inner">
    <h2 class="lb-bundle-ritual__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="lb-bundle-ritual__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="lb-bundle-ritual__cols">
      {%- if ritual.am and ritual.am.size > 0 -%}
      <div class="lb-bundle-ritual__col">
        <div class="lb-bundle-ritual__col-hd">
          <span class="lb-bundle-ritual__icon" aria-hidden="true">☀</span>
          <h3 class="lb-bundle-ritual__col-title">Morning</h3>
        </div>
        <ol class="lb-bundle-ritual__steps">
          {%- for step in ritual.am -%}
            <li class="lb-bundle-ritual__step">
              <span class="lb-bundle-ritual__num">{{ forloop.index }}</span>
              <div class="lb-bundle-ritual__content">
                {%- if step.product != blank -%}
                  {%- assign p = all_products[step.product] -%}
                  {%- if p != blank -%}
                    <a href="{{ p.url }}" class="lb-bundle-ritual__name">{{ step.label | default: p.title }}</a>
                  {%- else -%}
                    <span class="lb-bundle-ritual__name">{{ step.label }}</span>
                  {%- endif -%}
                {%- else -%}
                  <span class="lb-bundle-ritual__name">{{ step.label }}</span>
                {%- endif -%}
                <p class="lb-bundle-ritual__action">{{ step.action }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ol>
      </div>
      {%- endif -%}

      {%- if ritual.pm and ritual.pm.size > 0 -%}
      <div class="lb-bundle-ritual__col">
        <div class="lb-bundle-ritual__col-hd">
          <span class="lb-bundle-ritual__icon" aria-hidden="true">☾</span>
          <h3 class="lb-bundle-ritual__col-title">Evening</h3>
        </div>
        <ol class="lb-bundle-ritual__steps">
          {%- for step in ritual.pm -%}
            <li class="lb-bundle-ritual__step">
              <span class="lb-bundle-ritual__num">{{ forloop.index }}</span>
              <div class="lb-bundle-ritual__content">
                {%- if step.product != blank -%}
                  {%- assign p = all_products[step.product] -%}
                  {%- if p != blank -%}
                    <a href="{{ p.url }}" class="lb-bundle-ritual__name">{{ step.label | default: p.title }}</a>
                  {%- else -%}
                    <span class="lb-bundle-ritual__name">{{ step.label }}</span>
                  {%- endif -%}
                {%- else -%}
                  <span class="lb-bundle-ritual__name">{{ step.label }}</span>
                {%- endif -%}
                <p class="lb-bundle-ritual__action">{{ step.action }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ol>
      </div>
      {%- endif -%}
    </div>

    {%- if ritual.notes != blank -%}
      <p class="lb-bundle-ritual__notes">{{ ritual.notes }}</p>
    {%- endif -%}
  </div>
</section>
<style>
  .lb-bundle-ritual { background: #fff; padding: 56px 16px; }
  .lb-bundle-ritual__inner { max-width: 980px; margin: 0 auto; }
  .lb-bundle-ritual__title { font-size: 32px; line-height: 1.2; margin: 0 0 8px; text-align: center; color: #25282a; }
  .lb-bundle-ritual__sub { text-align: center; color: #4a4a4a; max-width: 580px; margin: 0 auto 40px; font-size: 16px; line-height: 1.5; }
  .lb-bundle-ritual__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  @media (max-width: 720px) { .lb-bundle-ritual__cols { grid-template-columns: 1fr; gap: 24px; } }
  .lb-bundle-ritual__col { background: #f7f5f0; padding: 28px 24px; border-radius: 12px; }
  .lb-bundle-ritual__col-hd { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid #e0dcd3; }
  .lb-bundle-ritual__icon { font-size: 22px; color: #FFBA46; }
  .lb-bundle-ritual__col-title { font-size: 18px; margin: 0; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: #25282a; }
  .lb-bundle-ritual__steps { list-style: none; padding: 0; margin: 0; }
  .lb-bundle-ritual__step { display: flex; gap: 14px; align-items: flex-start; padding: 14px 0; border-bottom: 1px solid #ebe7dd; }
  .lb-bundle-ritual__step:last-child { border-bottom: none; padding-bottom: 0; }
  .lb-bundle-ritual__step:first-child { padding-top: 0; }
  .lb-bundle-ritual__num { flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%; background: #FFBA46; color: #1a1a1a; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px; }
  .lb-bundle-ritual__content { flex: 1; }
  .lb-bundle-ritual__name { display: block; font-weight: 600; color: #25282a; text-decoration: none; font-size: 15px; line-height: 1.3; }
  a.lb-bundle-ritual__name:hover { color: #4f6f5d; text-decoration: underline; }
  .lb-bundle-ritual__action { color: #555; font-size: 13px; line-height: 1.45; margin: 4px 0 0; }
  .lb-bundle-ritual__notes { margin: 32px auto 0; padding: 16px 20px; background: #f7f5f0; border-left: 3px solid #FFBA46; border-radius: 4px; font-size: 14px; line-height: 1.55; color: #4a4a4a; max-width: 700px; }
</style>
{%- endif -%}
{% schema %}
{
  "name": "LB Bundle Ritual",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your ritual" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "When and how to use each product." }
  ],
  "presets": [{ "name": "LB Bundle Ritual" }]
}
{% endschema %}
