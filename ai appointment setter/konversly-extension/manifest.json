{
  "manifest_version": 3,
  "name": "Konversly Outbound Agent",
  "version": "0.1.0",
  "description": "Instagram outbound DM outreach with AI-personalized messages",
  "permissions": ["storage", "alarms", "tabs", "activeTab"],
  "host_permissions": ["https://www.instagram.com/*", "https://instagram.com/*"],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*", "https://instagram.com/*"],
      "js": ["src/content/scraper.ts", "src/content/profile-enricher.ts", "src/content/dm-sender.ts"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  }
}
